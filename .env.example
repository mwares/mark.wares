# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solar_monitor

# API Auth
JWT_SECRET=change-this-to-a-random-string-in-production

# Encryption key for Tesla tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Tesla Fleet API (register at developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# API Server
PORT=3000
HOST=0.0.0.0

# Mobile app
EXPO_PUBLIC_API_URL=http://localhost:3000
