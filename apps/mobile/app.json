{
  "expo": {
    "name": "Solar Monitor",
    "slug": "solar-monitor",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "solar-monitor",
    "splash": {
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.solarmonitor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A"
      },
      "package": "app.solarmonitor"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
